@startuml concepts
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #555555
skinparam rectangle {
  BorderColor #9A9A9A
  FontColor #333333
}
skinparam card {
  BorderColor #3A78C2
  BackgroundColor #DCE9FA
  FontColor #1F4E8C
}
skinparam frame {
  BorderColor #9A9A9A
  FontColor #555555
}

rectangle "**Datapack** (tests side): what a test needs" as dp #FFFFFF {
  frame "**stage slot** bench\nasks for stage type //bench//" as stage_slot {
    card "**slot** controller\nrole //controller//\nslot type controller_app" as s_pilot
    card "**slot** logger\nrole //logger//\nslot type logger_app" as s_tm
  }
  card "**ad hoc slot** actuator\nrole //actuator_sim//" as s_prop
}

rectangle "**Lab roles**: what a component is for" as roles #FFFFFF {
  rectangle "//controller//\ndeploy, start, ready,\nstop, collect, install..." as r_pilot #F2F2F2
  rectangle "//logger//\ndeploy, start, ready..." as r_tm #F2F2F2
  rectangle "//actuator_sim//\ndeploy, start, stop..." as r_prop #F2F2F2
}

rectangle "**Lab** (lab side): what exists" as lab #FFFFFF {
  frame "**stage** bench_1\nstage type //bench//" as stage {
    card "**component** controller_1\nrole //controller//\nextends //mcu_board//" as c_pilot
    card "**component** logger_1\nrole //logger//\nextends //sbc//" as c_tm
  }
  card "**ad hoc component** sim_actuator\nrole //actuator_sim//, on lab_srv" as c_prop
}

s_pilot -[#3A78C2,bold]-> c_pilot : bound at run start\n(same role)
s_tm -[#3A78C2,bold]-> c_tm
s_prop -[#3A78C2,bold]-> c_prop
stage_slot .[#3A78C2,bold].> stage : bound and locked\n(same stage type)

s_pilot -[#999999,dashed]-> r_pilot : role
r_pilot <-[#999999,dashed]- c_pilot : implements\nits commands
s_tm -[#999999,dashed]-> r_tm
r_tm <-[#999999,dashed]- c_tm
s_prop -[#999999,dashed]-> r_prop
r_prop <-[#999999,dashed]- c_prop
@enduml
