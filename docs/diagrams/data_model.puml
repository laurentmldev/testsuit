@startuml data_model
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #555555
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle
hide empty members

package "Tests side (test authors)" as testside {
  class "Test definition" as TestDef
  class "Setup configuration" as SetupConf
  class "Logical component" as LComp {
    role, inputs
  }
  class "Pipeline" as Pipeline {
    phases of steps
  }
}

package "Lab side (lab operators)" as labside {
  class "Stage" as Stage
  class "Component" as Component {
    host, role
  }
  class "Component type" as Type {
    commands: deploy, start,
    stop, collect...
  }
}

class "Datapack" as Datapack
class "Run" as Run {
  verdict, results
}

TestDef *-- SetupConf
TestDef *-- Pipeline
SetupConf *-- "*" LComp
Pipeline --> LComp : steps run\ncommands on

Stage o-- "*" Component
Component --> Type

Datapack --> TestDef : built from
Run --> Datapack : runs
LComp ..> Component : bound by role\nwhen the run starts
@enduml
