# proxies of the build host, used by apt, wget and pip during the build (empty: no proxy).
# CI_HTTP_PROXY defaults to CI_HTTPS_PROXY.
CI_HTTP_PROXY=
CI_HTTPS_PROXY=

# Miniconda installer: https://repo.anaconda.com/miniconda/<CONDA_VERSION>-Linux-x86_64.sh
CONDA_VERSION=Miniconda3-py313_26.3.2-2

# testsuit as pip installs it; for a branch of the repository:
# TESTSUIT_SPEC=testsuit[sequencer] @ git+https://github.com/laurentmldev/testsuit@main
TESTSUIT_SPEC=testsuit[sequencer]>=0.4.6

# tag of the built image, and the host port of the sequencer UI and REST API
TOYTRAIN_TAG=latest
TSQ_PORT=8640
